# 이 파일을 복사해 .env 로 만들어 사용 (.env는 git에 올리지 않음)
DB_NAME=nagasseum
DB_URL=jdbc:mysql://localhost:3306/nagasseum?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=1234
REDIS_HOST=localhost
REDIS_PORT=6379

# 외부 API 키 (담당자가 발급 후 채울 것)
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
CODEF_OAUTH_DOMAIN=https://oauth.codef.io
CODEF_API_DOMAIN=https://development.codef.io
# Connected ID AES-256 암호화 키 (openssl rand -base64 32 로 생성)
CODEF_ENCRYPT_KEY=
KAKAO_REST_API_KEY=
MOLIT_SERVICE_KEY=
POLICY_API_KEY=
SLACK_WEBHOOK_URL=

# Gemini (AI 정책 적격심사 / 채팅 요약) — Google AI Studio 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
